        "# Solicitando ao usuário a quantidade de fatores e respostas\n",
        "num_fatores = int(input(\"\\nQuantos fatores você deseja analisar? \"))\n",
        "fatores = []\n",
        "for i in range(num_fatores):\n",
        "    fator = input(f\"Digite o nome da coluna correspondente ao Fator {i+1}: \")\n",
        "    fatores.append(fator)\n",
        "\n",
        "num_respostas = int(input(\"\\nQuantas respostas você deseja analisar? \"))\n",
        "respostas = []\n",
        "for i in range(num_respostas):\n",
        "    resposta = input(f\"Digite o nome da coluna correspondente à Resposta {i+1}: \")\n",
        "    respostas.append(resposta)\n",
        "\n",
        "# Exibindo os fatores e respostas selecionados\n",
        "print(\"\\nFatores selecionados:\", fatores)\n",
        "print(\"Respostas selecionadas:\", respostas)\n"
      ],
